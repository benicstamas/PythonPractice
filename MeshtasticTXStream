from meshtastic.serial_interface import SerialInterface
import time
import datetime
import subprocess
import time
from datetime import datetime

# Configuration
interval_seconds = 5
max_messages = 1000
max_retries = 3

for i in range(max_messages):
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    message_text = f"Message {i+1} at {timestamp}"
    
    success = False
    for attempt in range(1, max_retries + 1):
        try:
            subprocess.run(["meshtastic", "--sendtext", message_text], check=True)
            print(f"✅ Sent: {message_text} (Attempt {attempt})")
            success = True
            break
        except subprocess.CalledProcessError as e:
            print(f"⚠️ Error sending message {i+1} (Attempt {attempt}): {e}")
            if attempt < max_retries:
                print("Retrying...")
                time.sleep(2)  # short delay before retry
            else:
                print("❌ Failed after 3 attempts. Skipping this message.")
    
    # Wait before next message only if previous message was successful
    if success:
        time.sleep(interval_seconds)