
# decode_senml_cbor_to_csv.py
import csv, json, os, sys
import cbor2
from datetime import datetime, timezone

def to_iso(ts_seconds):
    # Convert seconds to ISO 8601 UTC (Excel-friendly if kept as text; Power Query can parse)
    return datetime.fromtimestamp(ts_seconds, tz=timezone.utc).isoformat()

def flatten_pack(pack_bytes):
    pack = cbor2.loads(pack_bytes)  # pack: list of SenML records (dicts)
    rows = []

    # Read base fields once (they can appear on any record; spec allows sparse base fields)
    bn = None; bt = None; bu = None; bv = None; bs = None
    for rec in pack:
        # Update base values whenever present
        bn = rec.get('bn', bn)
        bt = rec.get('bt', bt)
        bu = rec.get('bu', bu)
        bv = rec.get('bv', bv)
        bs = rec.get('bs', bs)

        # For each record, emit a flattened row
        name = rec.get('n')
        unit = rec.get('u', bu)
        rel_t = rec.get('t')  # seconds offset relative to bt
        ut = rec.get('ut')    # absolute update time (seconds since epoch)

        # Value can be one of v/sv/bv/vd
        value = None; value_type = None
        for key in ('v', 'sv', 'bv', 'vd'):
            if key in rec:
                value = rec[key]; value_type = key; break

        # Compute timestamp text (ISO)
        # Prefer absolute time ut; else bt+t; else None
        abs_ts = None
        if isinstance(ut, (int, float)):
            abs_ts = ut
        elif isinstance(bt, (int, float)) and isinstance(rel_t, (int, float)):
            abs_ts = bt + rel_t

        ts_iso = to_iso(abs_ts) if abs_ts is not None else ""

        rows.append({
            "timestamp_iso": ts_iso,
            "base_name": bn or "",
            "name": name or "",
            "unit": unit or "",
            "value": value if value is not None else "",
            "value_type": value_type or "",
            "base_time": bt if bt is not None else "",
            "relative_time": rel_t if rel_t is not None else "",
            "update_time": ut if ut is not None else "",
            "base_unit": bu if bu is not None else "",
            "base_value": bv if bv is not None else "",
            "base_sum": bs if bs is not None else "",
        })
    return rows

def main(in_dir, out_csv):
    # Iterate .cbor or .senmlcbor files and append
    all_rows = []
    for fname in os.listdir(in_dir):
        if fname.lower().endswith((".cbor", ".senmlcbor")):
            with open(os.path.join(in_dir, fname), "rb") as f:
                try:
                    rows = flatten_pack(f.read())
                    # Optionally include source filename
                    for r in rows:
                        r["source_file"] = fname
                    all_rows.extend(rows)
                except Exception as e:
                    print(f"Failed {fname}: {e}", file=sys.stderr)

    fieldnames = [
        "timestamp_iso","base_name","name","unit","value","value_type",
        "base_time","relative_time","update_time","base_unit",
        "base_value","base_sum","source_file"
    ]
    with open(out_csv, "w", newline="", encoding="utf-8") as out:
        w = csv.DictWriter(out, fieldnames=fieldnames)
        w.writeheader()
        w.writerows(all_rows)

if __name__ == "__main__":
    if len(sys.argv) != 3:
        print("Usage: python decode_senml_cbor_to_csv.py <input_dir> <output.csv>")
        sys.exit(1)
    main(sys.argv[1], sys.argv[2])
